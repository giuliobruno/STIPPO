DATABASE_URL="file:./dev.db"
# Production Postgres example:
# DATABASE_URL="postgresql://user:pass@host:5432/visual_memory?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=

STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"

# S3 (when STORAGE_BACKEND=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Supabase (when STORAGE_BACKEND=supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=memories

FREE_MEMORY_LIMIT="100"
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Stripe (Pro $15/mo — create a Price in Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Capacitor (device testing)
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000

