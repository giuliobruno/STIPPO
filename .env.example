# --- Database (Postgres required) ---
# Local: Neon free tier, Supabase, or Docker Postgres
# DATABASE_URL="postgresql://user:pass@localhost:5432/stippo?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stippo?schema=public"

# --- Auth (required) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

# Optional: Google login (NextAuth) — separate from vault Drive sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- BYOS vault sync ---
# Set ONCE by you (developer). End users only click "Google Drive" / "Dropbox"
# and log into THEIR account — they never see or paste these keys.
#
# Google: Cloud Console → OAuth Web client + Drive API
# Origins: http://localhost:3000 (+ production URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dropbox (optional): https://www.dropbox.com/developers/apps
# Redirect URI: http://localhost:3000/app/vault
NEXT_PUBLIC_DROPBOX_APP_KEY=

# --- AI (server-only — NEVER use NEXT_PUBLIC_ for these) ---
# Prefer OpenRouter (one key → many models). Or use OpenAI direct.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Fallback if OPENROUTER_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Legacy server media (disabled in production by default — vault BYOS is primary)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
FREE_MEMORY_LIMIT="100"
# ALLOW_SERVER_MEDIA_UPLOADS="true"   # only if you intentionally re-enable /api/memories POST

# --- Password recovery email ---
# Prefer Resend. Without a mailer, local/dev can show an inline reset link.
# Production refuses inline links unless ALLOW_INLINE_RECOVERY=true.
RESEND_API_KEY=
EMAIL_FROM="Stippo <noreply@yourdomain.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Stippo <noreply@yourdomain.com>"
# ALLOW_INLINE_RECOVERY="true"   # emergency only

# --- Stripe Pro $15/mo (optional until monetizing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Capacitor device testing (LAN). Cleartext allowed only for http:// URLs.
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
