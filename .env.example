DATABASE_URL="file:./dev.db"
# Production: use Postgres
# DATABASE_URL="postgresql://user:pass@host:5432/stippo?schema=public"

# --- Auth (required) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Optional: Google login (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- BYOS vault sync ---
# Set ONCE by you (developer). End users only click "Google Drive" / "Dropbox"
# and log into THEIR account — they never see or paste these keys.
#
# Google: Cloud Console → OAuth Web client + Drive API
# Origins: http://localhost:3000 (+ production URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dropbox (optional): https://www.dropbox.com/developers/apps
# Redirect URI: http://localhost:3000/app/vault
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Optional Google login for NextAuth (separate from vault Drive sync)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI (server-only — NEVER use NEXT_PUBLIC_ for these) ---
# Prefer OpenRouter (one key → many models). Or use OpenAI direct.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Fallback if OPENROUTER_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Legacy server media (optional; vault is primary)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
FREE_MEMORY_LIMIT="100"

# --- Stripe Pro $15/mo (optional until monetizing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Capacitor device testing
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
