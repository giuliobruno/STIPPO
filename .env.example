# --- Database (Postgres required) ---
# Local: Neon free tier, Supabase, or Docker Postgres
# DATABASE_URL="postgresql://user:pass@localhost:5432/stippo?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stippo?schema=public"

# --- Auth (required) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

# Optional: Google login (NextAuth) — same Client ID is reused for vault Drive sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- BYOS vault sync (server env — exposed as public client IDs via /api/vault/oauth-config) ---
# End users only click Google Drive / OneDrive / Dropbox and log into THEIR account.
#
# Google Drive: uses GOOGLE_CLIENT_ID above (enable Drive API + authorized JS origins)
# Legacy alias still accepted: NEXT_PUBLIC_GOOGLE_CLIENT_ID
#
# Dropbox: https://www.dropbox.com/developers/apps
# Redirect URI: http://localhost:3000/app/vault (+ production URL)
DROPBOX_APP_KEY=
# Legacy alias: NEXT_PUBLIC_DROPBOX_APP_KEY
#
# OneDrive: Azure Portal → App registration (SPA) + Microsoft Graph Files.ReadWrite
# Redirect URI: http://localhost:3000/app/vault (+ production URL)
MSAL_CLIENT_ID=
# Aliases: ONEDRIVE_CLIENT_ID / NEXT_PUBLIC_MSAL_CLIENT_ID

# --- AI (server-only — NEVER use NEXT_PUBLIC_ for these) ---
# Prefer OpenRouter (one key → many models). Or use OpenAI direct.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Fallback if OPENROUTER_API_KEY is empty:
OPENAI_API_KEY=
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Legacy server media (disabled in production by default — vault BYOS is primary)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
FREE_MEMORY_LIMIT="100"
# ALLOW_SERVER_MEDIA_UPLOADS="true"   # only if you intentionally re-enable /api/memories POST

# --- Email (Resend) — required for signup confirmation + password reset ---
# 1) https://resend.com → API key
# 2) Domains → add stippo.app → copy SPF/DKIM (and DMARC) into Cloudflare DNS
# 3) Wait until domain is Verified, then use EMAIL_FROM on that domain
# Without a verified domain, mail often lands in spam (or only works to your own inbox).
RESEND_API_KEY=
EMAIL_FROM="Stippo <noreply@stippo.app>"
EMAIL_REPLY_TO="hello@stippo.app"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Stippo <noreply@stippo.app>"
# ALLOW_INLINE_RECOVERY="true"   # local/dev only: show verify/reset links in UI

# --- Stripe Pro $15/mo (optional until monetizing) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Capacitor device testing (LAN). Cleartext allowed only for http:// URLs.
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
